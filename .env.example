# ===========================================
# ThetaMac Environment Variables
# ===========================================
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Vercel, Fly.io)

# Node environment
NODE_ENV=development

# ===========================================
# Authentication (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Must match your deployment URL
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Application URLs
# ===========================================
# Your main application URL (Vercel in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket server URL (Fly.io in production)
# Leave empty for local dev (uses same origin)
NEXT_PUBLIC_SOCKET_URL=

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/thetamac

# ===========================================
# Google OAuth
# ===========================================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Stripe Billing
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from your Stripe dashboard
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ===========================================
# Fly.io (Production WebSocket Server Only)
# ===========================================
# Set WEBSOCKET_ONLY=true on Fly.io to run in WebSocket-only mode
# WEBSOCKET_ONLY=true
# FLY_APP_NAME is automatically set by Fly.io
