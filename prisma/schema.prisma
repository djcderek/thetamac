// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH.JS REQUIRED MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  image         String?
  password      String?   // For credentials auth (hashed)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // User settings
  settings      UserSettings?

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]
  
  // App relations
  stats         UserStats?
  trainingSessions TrainingSession[]
  problemAttempts  ProblemAttempt[]

  @@map("users")
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  
  soundEnabled      Boolean  @default(true)
  notificationsEnabled Boolean @default(true)
  autoAdvance       Boolean  @default(true)
  
  defaultDifficulty String   @default("Medium")
  defaultTimer      String   @default("10s")
  
  theme             String   @default("system") // "light", "dark", "system"

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// USER STATISTICS
// ============================================

model UserStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  
  // Overall stats
  totalProblems     Int      @default(0)
  totalCorrect      Int      @default(0)
  totalTimePlayed   Int      @default(0) // in seconds
  longestStreak     Int      @default(0)
  currentStreak     Int      @default(0)
  
  // Per-operation stats (stored as JSON for flexibility)
  additionStats     Json     @default("{\"total\": 0, \"correct\": 0, \"avgTime\": 0}")
  subtractionStats  Json     @default("{\"total\": 0, \"correct\": 0, \"avgTime\": 0}")
  multiplicationStats Json   @default("{\"total\": 0, \"correct\": 0, \"avgTime\": 0}")
  divisionStats     Json     @default("{\"total\": 0, \"correct\": 0, \"avgTime\": 0}")
  
  // Ranking
  rating            Int      @default(1000) // ELO-style rating
  rank              Int?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// ============================================
// TRAINING SESSIONS
// ============================================

model TrainingSession {
  id              String    @id @default(cuid())
  userId          String
  
  // Session config
  gameMode        String    // "timed", "practice", "learning"
  difficulty      String    // "easy", "medium", "hard", "expert"
  operations      String[]  // ["+", "-", "×", "÷"]
  
  // Session results
  totalProblems   Int       @default(0)
  correctAnswers  Int       @default(0)
  duration        Int       @default(0) // in seconds
  averageTime     Float     @default(0) // avg time per problem
  bestStreak      Int       @default(0)
  
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts        ProblemAttempt[]

  @@map("training_sessions")
}

// ============================================
// PROBLEM ATTEMPTS (for detailed analytics)
// ============================================

model ProblemAttempt {
  id              String    @id @default(cuid())
  userId          String
  sessionId       String?
  
  // Problem details
  operandA        Int
  operandB        Int
  operation       String    // "+", "-", "×", "÷"
  correctAnswer   Int
  userAnswer      Int?
  
  // Result
  isCorrect       Boolean
  timeTaken       Float     // in seconds
  
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, operation])
  @@index([userId, createdAt])
  @@map("problem_attempts")
}

// ============================================
// LEADERBOARD (denormalized for fast queries)
// ============================================

model LeaderboardEntry {
  id              String    @id @default(cuid())
  
  // User info (denormalized for fast queries)
  userId          String    @unique
  username        String
  image           String?
  
  // Stats
  rating          Int       @default(1000)
  totalProblems   Int       @default(0)
  accuracy        Float     @default(0)
  avgTime         Float     @default(0)
  
  // Ranking
  rank            Int?
  
  updatedAt       DateTime  @updatedAt

  @@index([rating(sort: Desc)])
  @@index([rank])
  @@map("leaderboard")
}

// ============================================
// MULTIPLAYER MATCHES
// ============================================

model MultiplayerMatch {
  id              String    @id @default(cuid())
  
  // Players
  player1Id       String
  player2Id       String
  
  // Match details
  player1Score    Int       @default(0)
  player2Score    Int       @default(0)
  winnerId        String?
  isDraw          Boolean   @default(false)
  
  // Rating changes
  player1RatingBefore Int
  player2RatingBefore Int
  player1RatingChange Int   @default(0)
  player2RatingChange Int   @default(0)
  
  // Match config
  totalRounds     Int       @default(10)
  difficulty      String    @default("medium")
  
  // Status
  status          String    @default("in_progress") // "in_progress", "completed", "forfeit", "disconnected"
  forfeitedBy     String?
  
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  
  // Relations
  rounds          MatchRound[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([createdAt(sort: Desc)])
  @@map("multiplayer_matches")
}

model MatchRound {
  id              String    @id @default(cuid())
  matchId         String
  roundNumber     Int
  
  // Problem
  operandA        Int
  operandB        Int
  operation       String
  correctAnswer   Int
  
  // Results
  player1Answer   Int?
  player2Answer   Int?
  player1TimeMs   Int?
  player2TimeMs   Int?
  winnerId        String?   // null if no winner (timeout)
  
  createdAt       DateTime  @default(now())
  
  // Relations
  match           MultiplayerMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_rounds")
}
